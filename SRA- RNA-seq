library(Rsamtools)
# 不在 BAM 中需要指定路径
bam_file <- "D:/下载专用/PRJNA1191165/soybean_aligned.bam"
bam_flags <- scanBam(bam_file, param = ScanBamParam(what = "flag"))[[1]]$flag
total_reads  <- length(bam_flags)
