cat(sprintf("多重比对: %.2f%%\n", bam_stats$percent_multimapping * 100))


# ============================================================
# 外显子水平（exon-level）计数
# ============================================================
counts <- featureCounts(
    files               = "soybean_aligned.bam",
    annot.ext           = "D:/生信文件/生信原始数据/大豆ncbi_dataset/data/GCA_000004515.5/genomic.gff",
    isGTFAnnotationFile = TRUE,
    GTF.featureType     = "exon",
    GTF.attrType        = "ID",
    GTF.attrType.extra  = c("Parent", "Name"),
    allowMultiOverlap   = TRUE,
    isPairedEnd         = TRUE,
    nthreads            = 4
)

# 保存外显子文件
write.csv(counts$counts, "soybean_gene_counts.csv")

# 将 counts 对象转换为数据框
exon_counts <- as.data.frame(counts$counts)
exon_counts$exon_id <- rownames(exon_counts)
colnames(exon_counts)[1] <- "count"
exon_counts$gene_id <- gsub("exon-gnl\\|doejgi\\|([^.]+\\.[^.-]+).*", "\\1", exon_counts$exon_id)

# 按基因汇总计数
library(dplyr)
gene_counts <- exon_counts %>%
    group_by(gene_id) %>%
    summarise(expression_count = sum(count)) %>%
    arrange(desc(expression_count))

# 保存基因水平计数
write.csv(gene_counts, "soybean_gene_counts.csv", row.names = FALSE)
